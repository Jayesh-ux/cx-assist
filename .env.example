# ─── Database ─────────────────────────────────────────────
POSTGRES_USER=cx
POSTGRES_PASSWORD=cxpass
POSTGRES_DB=cxassist
DATABASE_URL=postgresql+psycopg2://cx:cxpass@localhost:5432/cxassist

# ─── Vector DB (ChromaDB) ─────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_HTTP=true

# ─── Embeddings ───────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small

# ─── LLM (OmniRoute primary + Gemini fallback) ─────────────
# Get free Gemini key: https://aistudio.google.com/apikey
OMNIPATH_API_KEY=replace-me
GEMINI_API_KEY=your-gemini-api-key-here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
TEMPERATURE=0.0
MAX_TOKENS=800

# ─── Retrieval / validation thresholds ────────────────────
CHUNK_SIZE=900
CHUNK_OVERLAP=120
TOP_K=5
SCORE_THRESHOLD=0.55
CONFIDENCE_THRESHOLD=0.60

# ─── Auth (admin panel) ───────────────────────────────────
ADMIN_API_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
SECRET_KEY=change-me-to-a-long-random-secret

# ─── Redis (cache + retry queue + rate limiting) ──────────
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=120

# ─── Webhook (optional) ───────────────────────────────────
WEBHOOK_URL=

# ─── Brand isolation guard ────────────────────────────────
ENFORCE_BRAND_ISOLATION=true
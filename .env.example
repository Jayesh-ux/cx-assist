# ─── Database ─────────────────────────────────────────────
POSTGRES_USER=cx
POSTGRES_PASSWORD=cxpass
POSTGRES_DB=cxassist
DATABASE_URL=postgresql+psycopg2://cx:cxpass@localhost:5432/cxassist

# ─── Vector DB (ChromaDB) ─────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_HTTP=true

# ─── Embeddings ───────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small

# ─── LLM (OmniRoute primary + Gemini fallback) ─────────────
# Point OMNIPATH_URL at an OpenAI-compatible router/gateway.
# Self-host OmniRoute (npm i -g omniroute) and use
#   OMNIPATH_URL=http://localhost:20128/v1/chat/completions  LLM_MODEL=auto
# Keyless routers (REQUIRE_API_KEY=false) work with OMNIPATH_API_KEY empty.
# Fallback: free Gemini key at https://aistudio.google.com/apikey
OMNIPATH_URL=https://omniroute.ai/v1/chat/completions
OMNIPATH_API_KEY=replace-me
GEMINI_API_KEY=your-gemini-api-key-here
LLM_PROVIDER=auto
LLM_MODEL=
TEMPERATURE=0.0
MAX_TOKENS=800

# ─── Retrieval / validation thresholds ────────────────────
CHUNK_SIZE=900
CHUNK_OVERLAP=120
TOP_K=5
SCORE_THRESHOLD=0.30
CONFIDENCE_THRESHOLD=0.60

# ─── Workflow behaviour ───────────────────────────────────
WORKFLOW_GRADER_ENABLED=true      # grade retrieved chunks before generation
WORKFLOW_LLM_REVIEWER_ENABLED=false  # extra adversarial LLM pass (extra quota)
WORKFLOW_SCRAPE_ENABLED=true      # SSRF-hardened help-page fallback when KB empty

# ─── Auth ─────────────────────────────────────────────────
# SECRET_KEY is REQUIRED — the app refuses to boot with the insecure default.
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Bootstrap admin (seeded once at startup; self-registration is agent-only).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_FULL_NAME=Platform Admin

# ─── Redis (cache + retry queue + rate limiting) ──────────
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=120

# ─── Webhook (optional) ───────────────────────────────────
WEBHOOK_URL=

# ─── Brand isolation guard ────────────────────────────────
ENFORCE_BRAND_ISOLATION=true